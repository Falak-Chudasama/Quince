# ============================================================
# Quince MCP — example environment variables
# Copy this file to .env (already gitignored) and fill values.
# ============================================================

# ---- Browser Bridge ----------------------------------------
# Master switch: set to false to disable the bridge entirely.
QUINCE_BRIDGE_ENABLED=true

# Host the bridge listens on. MUST be 127.0.0.1 (loopback only).
QUINCE_BRIDGE_HOST=127.0.0.1

# TCP port for the WebSocket bridge. Match with the extension options page.
QUINCE_BRIDGE_PORT=7100

# Shared secret token. If unset, a token is auto-generated and written to
# quince_mcp/bridge/.bridge_token — paste it into the extension options page.
# QUINCE_BRIDGE_TOKEN=

# Optional: pin the Chrome extension ID for extra security.
# Find it at chrome://extensions (enabled developer mode).
# QUINCE_BRIDGE_EXTENSION_ID=

# ---- RTSI (Real-Time Screen Interaction) -------------------
# Maximum characters in a page snapshot sent to the LLM (2000–20000).
RTSI_SNAPSHOT_MAX_CHARS=6000

# Maximum state-changing action attempts per RTSI session.
RTSI_MAX_STEPS=40

# Session absolute timeout in seconds (15 min default).
RTSI_MAX_DURATION_S=900

# Session idle timeout in seconds (10 min default).
RTSI_IDLE_TIMEOUT_S=600

# Judge policy: always | adaptive
# always = every ACT goes through COMPARE -> JUDGE (default, safest)
# adaptive = skip COMPARE/JUDGE for clean simple actions (faster)
RTSI_JUDGE_POLICY=always

# Speed option: merge COMPARE and JUDGE into one hop (true | false).
RTSI_MERGE_COMPARE_JUDGE=false

# Risk gate: on | off. Controls whether irreversible actions require
# spoken confirmation before execution.
RTSI_RISK_GATE=on

# If true, successful/unsuccessful termination returns terminate=True
# instead of the root menu (default false = multi-task chaining).
RTSI_TERMINATION_ENDS_LOOP=false

# Debug: return raw state-change JSON instead of rendered text (false by default).
RTSI_RETURN_RAW_STATE_CHANGE=false
