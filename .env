APPLICATION=quince

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SAMPLE_WIDTH=2
AUDIO_BLOCKSIZE=640

AUDIO_INPUT_DEVICE=Headset (OnePlus Nord Buds 3r)
AUDIO_OUTPUT_DEVICE=Headphones (OnePlus Nord Buds 3r)

AUDIO_HOST_API=Windows WASAPI
AUDIO_INPUT_HOST_API=Windows WASAPI
AUDIO_OUTPUT_HOST_API=Windows WASAPI

AUDIO_FALLBACK_TO_DEFAULT=false

AUDIO_WASAPI_EXCLUSIVE=false
AUDIO_WASAPI_AUTO_CONVERT=true

AUDIO_INPUT_LATENCY=low
AUDIO_OUTPUT_LATENCY=low

AUDIO_INPUT_GAIN=1.0

STT_PROMPT="Your name is Quince, Transcribe the spoken audio accurately in English. Return only the words that were spoken. Do not translate, summarize, or invent words."

TTS_VOICE=jane
TTS_SAMPLE_RATE=24000
TTS_CHANNELS=1
TTS_SAMPLE_WIDTH=2