APPLICATION=quince

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SAMPLE_WIDTH=2
AUDIO_BLOCKSIZE=640

# Headphone Mic: Headset (OnePlus Nord Buds 3r)
# Built-in Mic: Microphone Array (Realtek(R) Audio)
AUDIO_INPUT_DEVICE=Headset (OnePlus Nord Buds 3r)

# Headphone Speaker: Headphones (OnePlus Nord Buds 3r) 
# Built-in Speaker: Speakers (Realtek(R) Audio)
AUDIO_OUTPUT_DEVICE=Headphones (OnePlus Nord Buds 3r)

AUDIO_HOST_API=Windows WASAPI
AUDIO_INPUT_HOST_API=Windows WASAPI
AUDIO_OUTPUT_HOST_API=Windows WASAPI

AUDIO_FALLBACK_TO_DEFAULT=true

AUDIO_WASAPI_EXCLUSIVE=false
AUDIO_WASAPI_AUTO_CONVERT=true

AUDIO_INPUT_LATENCY=low
AUDIO_OUTPUT_LATENCY=low

AUDIO_INPUT_GAIN=1.0

STT_PROMPT="Your name is Quince, Transcribe the spoken audio accurately in English. Return only the words that were spoken. Do not translate, summarize, or invent words."

TTS_VOICE=jane
TTS_SAMPLE_RATE=24000
TTS_CHANNELS=1
TTS_SAMPLE_WIDTH=2

# Network Endpoints & Ports
BASKET_WS_URL=ws://127.0.0.1:10010/ws
QUINCE_SERVER_HOST=127.0.0.5
QUINCE_SERVER_PORT=10000
QUINCE_MCP_HOST=127.0.0.5
QUINCE_MCP_PORT=10010
QUINCE_BRIDGE_HOST=127.0.0.5
QUINCE_BRIDGE_PORT=7100
