# Copy this file to .env and fill in what you need.
# Anything le ft blank uses the default in quince_client/config.py.

APPLICATION="quince"

# ============================================================
# BASKET (server) CONNECTION
# ============================================================
BASKET_WS_URL=ws://127.0.0.1:7000/ws
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=20
WS_MAX_SIZE=
WS_CONNECT_TIMEOUT=8

WS_RECONNECT=true
WS_RECONNECT_INITIAL_DELAY=1
WS_RECONNECT_MAX_DELAY=30
WS_RECONNECT_BACKOFF=2
# 0 = retry forever
WS_RECONNECT_MAX_ATTEMPTS=0

# ============================================================
# AUDIO
# ============================================================
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SAMPLE_WIDTH=2
AUDIO_BLOCKSIZE=960

# Device pinning: substring match against the device name shown by
# sounddevice (run `python -m sounddevice` to list your devices).
# Leave blank to use the OS default for that direction.
#
# Example for the exact setup this was built for:
#   AUDIO_INPUT_DEVICE=Microphone Array   -> always the laptop's built-in mic
#   AUDIO_OUTPUT_DEVICE=WH-1000XM5        -> always the bluetooth headset
# This keeps STT capture on the laptop mic even while a bluetooth
# headset is connected, while TTS still plays out through that headset.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

AUDIO_FALLBACK_TO_DEFAULT=true
AUDIO_DEVICE_WATCHDOG_INTERVAL=5

# ============================================================
# STT
# ============================================================
STT_PROMPT=You are named Quince
STT_STREAM=true

# ============================================================
# LLM
# ============================================================
LLM_MODEL=
LLM_TEMPERATURE=0.6
LLM_TOP_P=1.0
LLM_MAX_TOKENS=180
LLM_SEED=
# Leave blank to use the built-in hearing-optimized prompt in
# quince_client/prompts/system_prompt.py
LLM_SYSTEM_PROMPT=
LLM_ABSTRACTED=true

# ============================================================
# TTS
# ============================================================
TTS_VOICE=jane
TTS_TEMPERATURE=0.5
TTS_SAMPLE_RATE=24000
TTS_CHANNELS=1
TTS_SAMPLE_WIDTH=2

# ============================================================
# INPUT
# ============================================================
PUSH_TO_TALK_HOTKEY=ctrl+q

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
